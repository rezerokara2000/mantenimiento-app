---
import SearchInput from '../ui/SearchInput.astro';
import ExportToolbar from '../lists/ExportToolbar.astro';

export interface Props {
  exportAll?: boolean;
}
const { exportAll = false } = Astro.props;
const field =
  'h-12 w-full rounded-lg border-2 border-slate-300 bg-white px-3 text-base text-slate-900 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-300';
const label = 'mb-1 block text-sm font-bold text-slate-800';
---

<section class="rounded-xl bg-white p-3 shadow ring-1 ring-slate-300" aria-label="Búsqueda y filtros">
  <div class="flex gap-2">
    <div class="min-w-0 flex-1">
      <SearchInput model="filters.q" placeholder="Título, lugar, trabajador o DNI" />
    </div>
    <button
      type="button"
      x-on:click="showFilters = !showFilters"
      x-bind:aria-expanded="showFilters.toString()"
      class="relative h-12 shrink-0 rounded-lg border-2 border-slate-900 bg-slate-900 px-4 font-bold text-white hover:bg-slate-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
    >
      Filtros
      <span
        x-show="activeFilters > 0"
        x-cloak
        x-text="activeFilters"
        class="absolute -right-2 -top-2 flex h-6 min-w-6 items-center justify-center rounded-full bg-amber-400 px-1 text-xs font-extrabold text-slate-900"
      ></span>
    </button>
  </div>

  <div x-show="showFilters" x-cloak class="mt-3 grid grid-cols-2 gap-3 border-t border-slate-200 pt-3 lg:grid-cols-5">
    <div>
      <label for="f-from" class={label}>Desde</label>
      <input id="f-from" type="date" x-model="filters.from" class={field} />
    </div>
    <div>
      <label for="f-to" class={label}>Hasta</label>
      <input id="f-to" type="date" x-model="filters.to" class={field} />
    </div>
    <div>
      <label for="f-type" class={label}>Tipo de evento</label>
      <select id="f-type" x-model="filters.typeId" class={field}>
        <option value="">Todos</option>
        <template x-for="t in types" x-bind:key="t.id">
          <option x-bind:value="t.id" x-text="t.name"></option>
        </template>
      </select>
    </div>
    <div>
      <label for="f-shift" class={label}>Turno</label>
      <select id="f-shift" x-model="filters.shift" class={field}>
        <option value="">Día y Noche</option>
        <option value="DIA">Solo Día</option>
        <option value="NOCHE">Solo Noche</option>
      </select>
    </div>
    <div class="col-span-2 lg:col-span-1">
      <label for="f-aff" class={label}>Afiliación</label>
      <select id="f-aff" x-model="filters.affiliation" class={field}>
        <option value="">Todas</option>
        <template x-for="a in affiliations" x-bind:key="a">
          <option x-bind:value="a" x-text="a"></option>
        </template>
      </select>
    </div>
  </div>

  <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
    <p class="text-sm font-semibold text-slate-700" aria-live="polite">
      <span x-text="filtered.length"></span>
      <span x-text="filtered.length === 1 ? 'evento' : 'eventos'"></span>
      <template x-if="activeFilters > 0">
        <button type="button" x-on:click="resetFilters()" class="ml-2 font-bold text-red-700 underline underline-offset-2">
          Limpiar filtros
        </button>
      </template>
    </p>
    {
      exportAll && (
        <ExportToolbar
          compact
          pdf="exportAll('pdf')"
          excel="exportAll('excel')"
          whatsapp="exportAll('whatsapp')"
          copy="exportAll('text')"
        />
      )
    }
  </div>
</section>
