---
/**
 * Modal genérico controlado por Alpine.
 *  - show:    expresión Alpine booleana (p. ej. "detail" o "form")
 *  - onClose: expresión que lo cierra (p. ej. "detail = null")
 *  - title:   texto estático o expresión si dynamicTitle = true
 * Slots: default (contenido) y "footer" (acciones).
 */
export interface Props {
  show: string;
  onClose: string;
  title?: string;
  titleExpr?: string;
  size?: 'sm' | 'md' | 'lg';
}
const { show, onClose, title = '', titleExpr, size = 'md' } = Astro.props;
const width = { sm: 'sm:max-w-md', md: 'sm:max-w-2xl', lg: 'sm:max-w-4xl' }[size];
const hasFooter = Astro.slots.has('footer');
---

<div
  x-show={show}
  x-cloak
  x-on:keydown.escape.window={`if (${show}) { ${onClose} }`}
  class="fixed inset-0 z-50 flex items-end justify-center sm:items-center sm:p-4"
  role="dialog"
  aria-modal="true"
>
  <div
    x-show={show}
    x-transition.opacity
    x-on:click={onClose}
    class="absolute inset-0 bg-slate-950/70"
    aria-hidden="true"
  >
  </div>

  <div
    x-show={show}
    x-transition
    class:list={['relative flex max-h-[92vh] w-full flex-col overflow-hidden rounded-t-2xl bg-white shadow-2xl sm:rounded-2xl', width]}
  >
    <div class="flex items-center justify-between gap-3 border-b border-slate-200 bg-slate-900 px-4 py-3 text-white">
      {titleExpr ? <h2 class="text-lg font-bold" x-text={titleExpr} /> : <h2 class="text-lg font-bold">{title}</h2>}
      <button
        type="button"
        x-on:click={onClose}
        aria-label="Cerrar"
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-xl hover:bg-slate-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
      >
        ✕
      </button>
    </div>

    <div class="flex-1 overflow-y-auto p-4">
      <slot />
    </div>

    {
      hasFooter && (
        <div class="flex flex-wrap items-center justify-end gap-2 border-t border-slate-200 bg-slate-50 p-3">
          <slot name="footer" />
        </div>
      )
    }
  </div>
</div>
