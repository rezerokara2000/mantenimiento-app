<!-- Diálogo de confirmación global (store "confirm"): se usa antes de cualquier eliminación. -->
<div
  x-data
  x-show="$store.confirm.open"
  x-cloak
  x-on:keydown.escape.window="$store.confirm.open && $store.confirm.answer(false)"
  class="fixed inset-0 z-[60] flex items-center justify-center p-4"
  role="alertdialog"
  aria-modal="true"
  aria-labelledby="confirm-title"
>
  <div x-transition.opacity class="absolute inset-0 bg-slate-950/75" x-on:click="$store.confirm.answer(false)"></div>
  <div x-transition class="relative w-full max-w-md rounded-2xl bg-white p-5 shadow-2xl">
    <h2 id="confirm-title" class="text-lg font-extrabold text-slate-900" x-text="$store.confirm.title"></h2>
    <p class="mt-2 text-base text-slate-700" x-text="$store.confirm.message"></p>
    <div class="mt-5 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
      <button
        type="button"
        x-on:click="$store.confirm.answer(false)"
        class="min-h-12 rounded-lg border-2 border-slate-300 px-4 py-2 font-bold text-slate-800 hover:bg-slate-100"
      >
        Cancelar
      </button>
      <button
        type="button"
        x-on:click="$store.confirm.answer(true)"
        x-bind:class="$store.confirm.danger ? 'bg-red-700 hover:bg-red-800' : 'bg-slate-900 hover:bg-slate-800'"
        class="min-h-12 rounded-lg px-4 py-2 font-bold text-white"
        x-text="$store.confirm.confirmLabel"
      >
      </button>
    </div>
  </div>
</div>
