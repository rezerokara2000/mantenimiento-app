---
/** Buscador con botón de limpiar. `model` es la expresión Alpine enlazada (p. ej. "filters.q"). */
export interface Props {
  model: string;
  placeholder?: string;
  label?: string;
}
const { model, placeholder = 'Buscar…', label = 'Buscar' } = Astro.props;
---

<label class="relative block">
  <span class="sr-only">{label}</span>
  <svg class="pointer-events-none absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
    <circle cx="11" cy="11" r="7"></circle>
    <path stroke-linecap="round" d="M20 20l-3.5-3.5"></path>
  </svg>
  <input
    type="search"
    x-model.debounce.150ms={model}
    placeholder={placeholder}
    autocomplete="off"
    class="h-12 w-full rounded-lg border-2 border-slate-300 bg-white pl-10 pr-3 text-base text-slate-900 placeholder:text-slate-500 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-300"
  />
</label>
