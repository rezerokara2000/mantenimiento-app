---
export interface Props {
  links: { href: string; label: string; icon: string; hint: string }[];
  current: string;
}
const { links, current } = Astro.props;
const isActive = (href: string) => current === href || current === `${href}/`;
---

<div
  x-data="{ open: false }"
  x-on:keydown.escape.window="open = false"
  x-on:click.outside="open = false"
  class="relative"
>
  <button
    type="button"
    x-on:click="open = !open"
    x-bind:aria-expanded="open.toString()"
    aria-controls="menu-principal"
    aria-label="Abrir menú de navegación"
    class="flex h-11 w-11 items-center justify-center rounded-lg bg-slate-800 text-white ring-1 ring-slate-600 hover:bg-slate-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
  >
    <svg x-show="!open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
    </svg>
    <svg x-show="open" x-cloak class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
    </svg>
  </button>

  <nav
    id="menu-principal"
    x-show="open"
    x-cloak
    x-transition.origin.top.right
    class="absolute right-0 top-14 z-40 w-[min(92vw,22rem)] overflow-hidden rounded-xl bg-white shadow-2xl ring-1 ring-slate-900/20"
    aria-label="Secciones principales"
  >
    <ul class="divide-y divide-slate-200">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={isActive(l.href) ? 'page' : undefined}
              class:list={[
                'flex min-h-16 items-center gap-3 px-4 py-3 focus:outline-none focus-visible:bg-amber-100',
                isActive(l.href) ? 'bg-amber-100' : 'hover:bg-slate-100',
              ]}
            >
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-slate-900 text-lg" aria-hidden="true">
                {l.icon}
              </span>
              <span class="min-w-0">
                <span class="block text-base font-bold text-slate-900">{l.label}</span>
                <span class="block truncate text-sm text-slate-600">{l.hint}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>
